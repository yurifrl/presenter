# 1Password-referenced env. Run the stack with secrets injected, never commit real values:
#   op run --env-file=.env.op -- docker compose up
# Create the item once:  op item create --category=login --title=presenter --vault=Private \
#   google-client-id=... google-client-secret=... session-secret="$(openssl rand -hex 32)" \
#   allowed-emails=you@gmail.com google-redirect-uri=https://YOUR-PUBLIC-URL/auth/google/callback
PORT="7737"
DB_PATH="/data/presenter.sqlite"
GOOGLE_CLIENT_ID="op://Private/presenter/google-client-id"
GOOGLE_CLIENT_SECRET="op://Private/presenter/google-client-secret"
GOOGLE_REDIRECT_URI="op://Private/presenter/google-redirect-uri"
ALLOWED_EMAILS="op://Private/presenter/allowed-emails"
SESSION_SECRET="op://Private/presenter/session-secret"
# Whole-DB encryption key (libSQL/SQLCipher). Changing it makes an existing DB
# unreadable. Falls back to SESSION_SECRET if unset.
ENCRYPTION_KEY="op://Private/presenter/encryption-key"
# Password login is ephemeral: with no Google config the server prints a fresh
# password to the logs each boot.
ADMIN_EMAIL="admin"
