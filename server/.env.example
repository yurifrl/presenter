PORT=7737
DB_PATH=./presenter.sqlite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:7737/auth/google/callback
ALLOWED_EMAILS=you@example.com
SESSION_SECRET=change-me
# Whole-DB encryption key. Falls back to SESSION_SECRET if unset.
ENCRYPTION_KEY=
# Ephemeral password login: run the server with --login-password to print a
# fresh password each boot. ADMIN_EMAIL is the identity used for that session.
ADMIN_EMAIL=admin
